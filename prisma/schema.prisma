generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("agent")
  sessions      Session[]
  accounts      Account[]

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  templates        Template[]
  tractageSessions TractageSession[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum FieldType {
  text
  tel
  email
  number
  date
  select
}

enum TractageSource {
  ocr
  tablette
}

enum TractageStatut {
  en_cours
  valide
  exporte
}

enum EntryStatut {
  a_verifier
  valide
}

/// Un modèle de feuille de tractage : pilote le schéma OCR, le formulaire tablette et les en-têtes Excel.
model Template {
  id        String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  nom       String
  annee     Int
  actif     Boolean   @default(true)
  createdBy String?   @db.Uuid
  creator   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  fields   Field[]
  sessions TractageSession[]

  @@map("template")
}

/// Une colonne du formulaire de tractage. `key` est immuable une fois créé (RG-01).
model Field {
  id         String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  templateId String    @db.Uuid
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       FieldType
  requis     Boolean   @default(false)
  options    Json?
  ordre      Int
  actif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([templateId, key])
  @@map("field")
}

/// Une feuille de tractage remplie (établissement + date). À ne pas confondre avec `Session` (Better Auth).
model TractageSession {
  id            String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  templateId    String         @db.Uuid
  template      Template       @relation(fields: [templateId], references: [id])
  etablissement String
  dateTractage  DateTime       @db.Date
  source        TractageSource
  statut        TractageStatut @default(en_cours)
  fichierUrl    String?
  createdBy     String?        @db.Uuid
  creator       User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  entries Entry[]

  @@map("tractage_session")
}

/// Une ligne (un prospect) d'une feuille de tractage. `valeurs`/`confiance` en JSONB : ajouter un champ n'exige aucune migration.
model Entry {
  id        String          @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  sessionId String          @db.Uuid
  session   TractageSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ligne     Int
  valeurs   Json            @default("{}")
  confiance Json?
  statut    EntryStatut     @default(a_verifier)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("entry")
}
